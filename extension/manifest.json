{
  "name": "ReviseDsa",
  "description": "Add question on our sheet that helps you revise high-priority questions first",
  "version": "1.0",
  "manifest_version": 3,

  "action": {
    "default_popup": "hello.html"
  },

  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },

  "permissions": [
    "tabs",
    "scripting",
    "activeTab"
  ],

  "content_scripts": [
    {
      "js": ["scripts/leetcode.js"],
      "matches": [
        "https://leetcode.com/problems/*"
      ]
    },
    {
      "js": ["scripts/gfg.js"],
      "matches": [
        "https://www.geeksforgeeks.org/problems/*"
      ]
    }
  ],

  "background": {
    "service_worker": "background.js"
  }
}